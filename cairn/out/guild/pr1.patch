+static void html_escape(const char *in, size_t in_len, char *out, size_t out_len)
+{
+    size_t o = 0;
+    if (out_len == 0) return;
+    for (size_t i = 0; i < in_len && in[i] != '\0'; i++) {
+        const char *esc = NULL;
+        switch (in[i]) {
+            case '&': esc = "&amp;"; break;
+            case '<': esc = "&lt;"; break;
+            case '>': esc = "&gt;"; break;
+            case '"': esc = "&quot;"; break;
+            case '\'': esc = "&#39;"; break;
+            case ';': esc = "&#59;"; break;
+        }
+        if (esc) {
+            while (*esc && o < out_len - 1) {
+                out[o++] = *esc++;
+            }
+        } else {
+            if (o < out_len - 1) {
+                out[o++] = in[i];
+            }
+        }
+    }
+    out[o] = '\0';
+}
 
