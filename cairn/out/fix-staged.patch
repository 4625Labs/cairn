+// SSIDs come from nearby radios, not from us: never trust them into HTML
+// without escaping (a rogue SSID is an easy stored-XSS vector here).
+static void html_escape(const char *in, size_t in_len, char *out, size_t out_len)
+{
+    size_t o = 0;
+    if (out_len == 0) return;
+    for (size_t i = 0; i < in_len && in[i]; i++) {
+        const char *rep;
+        switch (in[i]) {
+        case '&':  rep = "&amp;";  break;
+        case '<':  rep = "&lt;";   break;
+        case '>':  rep = "&gt;";   break;
+        case '"':  rep = "&quot;"; break;
+        case '\'': rep = "&#39;";  break;
+        default:
+            if (o + 1 >= out_len) goto done;
+            out[o++] = in[i];
+            continue;
+        }
+        size_t rep_len = strlen(rep);
+        if (o + rep_len >= out_len) break;
+        memcpy(out + o, rep, rep_len);
+        o += rep_len;
+    }
+done:
+    out[o] = 0;
+}
