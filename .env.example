# Copy to the file names below and fill in. Never commit the real files.
# Loaded by: source cairn/env-clickhouse.sh   (reads .env.clickhouse)

# --- .env.clickhouse : ClickHouse Cloud HTTPS endpoint (port 8443) ---
CLICKHOUSE_URL=https://<your-service>.<region>.<cloud>.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<password>

# Optional, only for managing the service from the API. Not needed by Cairn.
# CLICKHOUSE_CLOUD_API_KEY=<key id>
# CLICKHOUSE_CLOUD_API_SECRET=<key secret>

# --- read-only user for the Akash-hosted Board (create it, then DROP it after the demo) ---
# CREATE USER cairn_ro IDENTIFIED BY '<password>';
# GRANT SELECT ON default.cairn_events TO cairn_ro;
# GRANT SELECT ON default.cairn_cards  TO cairn_ro;
# The Akash provider can read the SDL, so only this read-only user ever goes in deploy.yaml.

# --- .env.akash : Akash Console API key (managed wallet; revoke after the demo) ---
AKASH_API_KEY=<ac.sk. key>
